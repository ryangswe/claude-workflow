{
  "name": "A-calibrated",
  "about": "A-opus with the candidate checklist changes in candidates/calibrated/: missing records (a Missed by: line, plan or decision records) are Minor, and the state checklist asks whether every writer checks the current state before it writes.",
  "files": {
    ".claude/agents/reviewer.md": "../candidates/calibrated/reviewer.md",
    ".claude/review-checklists.md": "../candidates/calibrated/review-checklists.md"
  },
  "frontmatter": {
    "model": "opus",
    "effort": "high"
  },
  "max_budget_usd": 5,
  "timeout_s": 1800,
  "output": "claude-json",
  "command": [
    "claude",
    "-p",
    "{brief}",
    "--agents",
    "{agents_file}",
    "--agent",
    "reviewer",
    "--model",
    "{model}",
    "--effort",
    "{effort}",
    "--restricted",
    "--tools",
    "Read,Glob,Grep",
    "--strict-mcp-config",
    "--output-format",
    "json",
    "--permission-mode",
    "dontAsk",
    "--no-session-persistence",
    "--max-budget-usd",
    "{budget}",
    "--allowedTools",
    "Read",
    "Glob",
    "Grep"
  ],
  "tools": [
    "Read",
    "Glob",
    "Grep"
  ]
}
